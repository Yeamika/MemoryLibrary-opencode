# Root workspace meta repo
#
# This repo intentionally tracks only workspace-level memory, instructions,
# and local agent assets. Product code remains in each child repo's own git
# history.

# Ignore everything by default, then selectively unignore the meta-repo scope.
*

# Root docs / memory
!/.gitignore
!/AGENTS.md
!/LICENSE
!/README.md
!/TASKS.md
!/WORKSPACE_MAP.md
!/docs/
!/docs/**

# Workspace-local OpenCode meta files (but not runtime config or artifacts)
!/.opencode/
/.opencode/*
!/.opencode/opencode.json
!/.opencode/AGENTS.md
!/.opencode/agent/
!/.opencode/agent/**
!/.opencode/docx/
!/.opencode/docx/**
!/.opencode/skills/
!/.opencode/skills/**
!/.opencode/tools/
!/.opencode/tools/**

# Still ignore transient content inside tracked trees
/.opencode/agent/**/.DS_Store
/.opencode/skills/**/node_modules/
/.opencode/skills/**/.DS_Store

# Explicit local-only / separately-owned areas
/.config/
/.tmp/
/OpenSessionGateway/
/nextcloud-mcp-tool/
/Yeamika/
!/Yeamika/
/Yeamika/*
!/Yeamika/opencode/
/Yeamika/opencode/*
!/Yeamika/opencode/AGENTS.md
!/Yeamika/opencode/TASKS.md
/migration/
/osg-opencode-plugin-bundle.tgz
/osg-plugin-bundle.tar.gz
